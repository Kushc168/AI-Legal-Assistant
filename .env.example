# Copy to .env and fill in. Never commit .env.

# LLM provider: "anthropic" or "offline".
# "offline" uses deterministic heuristics and no network calls (useful for demos and tests).
# If LLM_PROVIDER is unset, "anthropic" is used when ANTHROPIC_API_KEY is set, otherwise "offline".
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Optional: private gateway / proxy URL for the Anthropic API. Leave empty for the public endpoint.
LLM_BASE_URL=
# Server-side refusal fallback ("default" or "off"). Turn off if your gateway rejects beta parameters.
LLM_FALLBACKS=default
LLM_TIMEOUT_SECONDS=120

# Storage
DATA_DIR=./data
MAX_UPLOAD_MB=25

# Server
HOST=127.0.0.1
PORT=8000
